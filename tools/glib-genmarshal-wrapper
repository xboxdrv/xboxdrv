#!/usr/bin/env python3
"""Rewrite deprecated glib-genmarshal --header --body to --body --prototypes.

dbus-binding-tool still invokes glib-genmarshal with the old pair, which
prints a deprecation warning on modern GLib. Intercept that invocation.
"""
import os
import shutil
import subprocess
import sys


def main() -> int:
    args = sys.argv[1:]
    if "--header" in args and "--body" in args:
        args = [a for a in args if a != "--header"]
        if "--prototypes" not in args:
            # Insert after --body if present, else append
            try:
                i = args.index("--body")
                args.insert(i + 1, "--prototypes")
            except ValueError:
                args.append("--prototypes")

    # Prefer a real glib-genmarshal that is not this wrapper
    self_real = os.path.realpath(__file__)
    real = None
    for path in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(path, "glib-genmarshal")
        if not os.path.isfile(cand) and not os.path.islink(cand):
            continue
        if not os.access(cand, os.X_OK):
            continue
        # Skip this wrapper (and the PATH shim symlink to it)
        if os.path.realpath(cand) == self_real:
            continue
        real = cand
        break
    if real is None:
        sys.stderr.write("glib-genmarshal-wrapper: glib-genmarshal not found in PATH\n")
        return 127

    return subprocess.call([real, *args])


if __name__ == "__main__":
    sys.exit(main())
